# Los archivos de /_next/static llevan un hash en el nombre: si cambia el
# contenido, cambia la URL. Se pueden cachear para siempre en vez de
# revalidar 763 KB en cada visita, que es lo que hacía el valor por defecto
# de 4 horas.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML sí tiene que revalidarse: es lo que apunta a los archivos nuevos.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Las imágenes que genera Next no llevan extensión, así que Pages no sabe qué
# son. Sin el tipo correcto, LinkedIn y WhatsApp no muestran la vista previa.
/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

# Seguridad. Nadie puede meter la portada ni el editor en un iframe; /embed
# sí, porque existe para eso. La CSP no usa frame-ancestors: Pages une con
# coma un header repetido y una segunda política no relajaría la primera.
# 'unsafe-inline' lo exige el export de Next (scripts inline sin nonce) y
# blob: lo exige Mapbox GL para sus workers. cloudflareinsights es el beacon
# de Web Analytics que Cloudflare inyecta en producción.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.mapbox.com; font-src 'self'; connect-src 'self' https://*.mapbox.com https://cloudflareinsights.com; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'

/embed
  ! X-Frame-Options

/embed.html
  ! X-Frame-Options
