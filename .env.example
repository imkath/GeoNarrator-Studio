# Public Mapbox token: https://account.mapbox.com/access-tokens/
# Add URL restrictions before deploying. It ships in the client bundle and is
# visible to anyone who opens the site.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Optional. Public site URL, used for metadata, robots.txt and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
